# Axil Local Environment Variables
#
# Copy this file to `.env` and adjust. Every variable the desktop (or its
# gate scripts) reads is listed below with its default. This file documents
# platform inputs only — credentials never belong here; the gateway is
# authenticated by the served Arbora stack, not by local tokens.

# ── Qt platform ──────────────────────────────────────────────────
# Qt platform plugin; set to `offscreen` for CI/CD, Docker, or headless boxes.
QT_QPA_PLATFORM=offscreen

# ── Terminal (embedded terminal widget) ─────────────────────────
# Terminal type advertised to the child PTY; inherited when already set.
TERM=xterm-256color

# ── Bundled-runtime (PyInstaller) ────────────────────────────────
# Temp execution directories set automatically by the PyInstaller bootloader
# for bundled apps; the dev tree path is the default when unset.
_MEIPASS=
_MEIPASS2=

# ── Gateway / operation registry ─────────────────────────────────
# Optional path to an alternate installed generated operation registry.
AXIL_OPERATION_REGISTRY_PATH=

# ── Agent-utilities gate ─────────────────────────────────────────
# Workspace root override for the agent-utilities gate; empty lets the
# gate search this checkout's workspace.
AGENT_UTILITIES_ROOT=

# ── Tracked-artifact privacy gate ────────────────────────────────
# Comma-separated sensitive-identifier override; empty falls back to the
# ambient (username/hostname) + git identity sources.
AGENT_UTILITIES_PRIVACY_IDENTIFIERS=

# ── Process identity inputs (normally set by the OS) ────────────
# The privacy gate reads the ambient account name; these mirror the OS
# values and default to the resolved OS user when unset.
USER=
LOGNAME=
USERNAME=
PATH=

# ── Execution-environment bookkeeping (set by the toolchain) ────
# CI test harness log sink and the pre-commit cache location, read by the
# test and pre-commit plumbing; empty means "set at run time".
COMMAND_LOG=
PRE_COMMIT_HOME=
